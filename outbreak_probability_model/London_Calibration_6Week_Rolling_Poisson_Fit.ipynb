   "id": "b48810d1",
   "metadata": {},
   "source": [
    "# Final non-seasonal London Poisson calibration\n",
    "\n",
    "This notebook fits the eight-parameter non-seasonal model directly to all rolling six-week London windows using the overlap-weighted Poisson negative log-likelihood. It is self-contained: the older composite-loss fit is not required. A reproducible bounded random search, local random refinement, and bounded Powell refinement produce the canonical non-seasonal Poisson fit used by downstream notebooks. An optional L-BFGS-B run is available only as a separately saved diagnostic and cannot replace the main fit.\n",
    "\n",
    "This is an all-data calibration. Its rolling-window diagnostics describe in-sample fit; chronological held-out performance is evaluated separately."
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "id": "1e69463d",
   "metadata": {},
   "outputs": [],
   "source": [
    "from pathlib import Path\n",
    "import sys\n",
    "import matplotlib.pyplot as plt\n",
    "import numpy as np\n",
    "import pandas as pd\n",
    "from scipy.optimize import minimize\n",
    "\n",
    "ROOT = Path.cwd().resolve()\n",
    "if ROOT.name == 'outbreak_probability_model': ROOT = ROOT.parent\n",
    "if str(ROOT) not in sys.path: sys.path.insert(0, str(ROOT))\n",
    "\n",
    "from outbreak_probability_model import load_default_inputs\n",
    "from outbreak_probability_model.london_calibration import (\n",
    "    CalibrationConfig, DEFAULT_LONDON_POISSON_FITTED_PARAMETERS,\n",
    "    FIT_PARAMETER_BOUNDS, PIPELINE_VERSION, calibration_starting_vector,\n",
    "    default_calibration_parameters, evaluate_vector, fit_shared_parameters,\n",
    "    fitted_parameter_table, load_london_confirmed_cases, make_six_week_blocks,\n",
    ")\n",
    "\n",
    "EXPECTED_PIPELINE_VERSION = 'mathsy-london-v7-random-search-120-40'\n",
    "if PIPELINE_VERSION != EXPECTED_PIPELINE_VERSION:\n",
    "    raise RuntimeError(\n",
    "        f'Stale notebook kernel: loaded {PIPELINE_VERSION}, expected '\n",
    "        f'{EXPECTED_PIPELINE_VERSION}. Restart the kernel and run all cells.'\n",
    "    )\n",
    "OUTPUT = DEFAULT_LONDON_POISSON_FITTED_PARAMETERS.parent\n",
    "OUTPUT.mkdir(parents=True, exist_ok=True)\n",
    "QUICK_CHECK = False\n",
    "RUN_OPTIONAL_GRADIENT = False  # diagnostic only; never replaces the main search fit\n",
    "if QUICK_CHECK:\n",
    "    config = CalibrationConfig(\n",
    "        block_weeks=6, n_trials=20, n_refinement_trials=6,\n",
    "        initial_state_refinement_maxiter=0, warmup_weeks=0,\n",
    "        random_seed=20260822,\n",
    "    )\n",
    "    GRADIENT_MAXITER = 8\n",
    "else:\n",
    "    config = CalibrationConfig(\n",
    "        block_weeks=6, n_trials=120, n_refinement_trials=40,\n",
    "        initial_state_refinement_maxiter=50, warmup_weeks=0,\n",
    "        random_seed=20260822,\n",
    "    )\n",
    "    GRADIENT_MAXITER = 120\n",
    "print('Output directory:', OUTPUT)\n",
    "print('Quick check:', QUICK_CHECK)\n",
    "print('Optional gradient diagnostic:', RUN_OPTIONAL_GRADIENT)"
   ]
  },
  {
   "cell_type": "markdown",
   "id": "df55a65c",
   "metadata": {},
   "source": [
    "## 1. Observations and final-run settings\n",
    "\n",
    "The observation immediately before each target window is the unscored anchor. The next six weekly counts are predicted and scored. Inverse coverage weights prevent a calendar week from receiving extra total weight merely because it appears in several overlapping windows."
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "id": "0b752bc0",
   "metadata": {},
   "outputs": [],
   "source": [
    "cases = load_london_confirmed_cases()\n",
    "blocks = make_six_week_blocks(cases, block_weeks=config.block_weeks, step_weeks=1)\n",
    "inputs = load_default_inputs()\n",
    "base = default_calibration_parameters()\n",
    "starting_vector = calibration_starting_vector(base, FIT_PARAMETER_BOUNDS)\n",
    "settings = pd.DataFrame([{\n",
    "    'pipeline_version': PIPELINE_VERSION, 'quick_check': QUICK_CHECK,\n",
    "    'observed_weeks': len(cases), 'rolling_windows': blocks.block_id.nunique(),\n",
    "    'forecast_weeks_per_window': config.block_weeks,\n",
    "    'objective': 'overlap-weighted Poisson NLL',\n",
    "    'n_trials': config.n_trials,\n",
    "    'n_refinement_trials': config.n_refinement_trials,\n",
    "    'initial_state_refinement_maxiter': config.initial_state_refinement_maxiter,\n",
    "    'run_optional_gradient': RUN_OPTIONAL_GRADIENT,\n",
    "    'gradient_maxiter': GRADIENT_MAXITER, 'random_seed': config.random_seed,\n",
    "}])\n",
    "settings.to_csv(OUTPUT / '00_poisson_fit_settings.csv', index=False)\n",
    "display(settings)\n",
    "display(fitted_parameter_table(base, starting_vector, FIT_PARAMETER_BOUNDS))"
   ]
  },
  {
   "cell_type": "markdown",
   "id": "eb57d2d4",
   "metadata": {},
   "source": [
    "## 2. Broad search and local random refinement"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "id": "b4186044",
   "metadata": {},
   "outputs": [],
   "source": [
    "search_vector, search_trials, search_diagnostics = fit_shared_parameters(\n",
    "    blocks, inputs=inputs, config=config, base_parameters=base, progress=True,\n",
    "    overlap_weighted=True, objective_metric='poisson_nll',\n",
    "    starting_vector=starting_vector, parameter_bounds=FIT_PARAMETER_BOUNDS,\n",
    ")\n",
    "search_score, search_diagnostics = evaluate_vector(\n",
    "    search_vector, blocks, inputs, base, overlap_weighted=True,\n",
    "    objective_metric='poisson_nll',\n",
    ")\n",
    "search_trials.to_csv(OUTPUT / '01_poisson_optimization_trials.csv', index=False)\n",
    "print(f'Broad-search Poisson NLL: {search_score:.8f}')\n",
    "display(fitted_parameter_table(base, search_vector, FIT_PARAMETER_BOUNDS))"
   ]
  },
  {
   "cell_type": "markdown",
   "id": "09259bc6",
   "metadata": {},
   "source": [
    "## 3. Optional numerical-gradient diagnostic\n",
    "\n",
    "The canonical fit is the bounded random search with local and hidden-state refinement from Section 2. Set `RUN_OPTIONAL_GRADIENT=True` only to examine whether L-BFGS-B can lower the in-sample Poisson loss. Its output is saved separately and never replaces the main fitted vector."
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "id": "b001cc00",
   "metadata": {},
   "outputs": [],
   "source": [
    "parameter_names = list(FIT_PARAMETER_BOUNDS)\n",
    "lower = np.array([FIT_PARAMETER_BOUNDS[name][0] for name in parameter_names])\n",
    "upper = np.array([FIT_PARAMETER_BOUNDS[name][1] for name in parameter_names])\n",
    "scale = upper - lower\n",
    "gradient_history = []\n",
    "\n",
    "def vector_to_unit(vector):\n",
    "    values = np.array([vector[name] for name in parameter_names], dtype=float)\n",
    "    return np.clip((values - lower) / scale, 0.0, 1.0)\n",
    "\n",
    "def unit_to_vector(unit_values):\n",
    "    values = lower + np.asarray(unit_values, dtype=float) * scale\n",
    "    return dict(zip(parameter_names, values))\n",
    "\n",
    "def objective_on_unit_scale(unit_values):\n",
    "    candidate = unit_to_vector(unit_values)\n",
    "    score, _ = evaluate_vector(\n",
    "        candidate, blocks, inputs, base, overlap_weighted=True,\n",
    "        objective_metric='poisson_nll',\n",
    "    )\n",
    "    gradient_history.append({'evaluation': len(gradient_history),\n",
    "                             'poisson_nll': score, **candidate})\n",
    "    return score\n",
    "\n",
    "gradient_result = None\n",
    "gradient_vector = None\n",
    "gradient_score = np.nan\n",
    "gradient_diagnostics = None\n",
    "if RUN_OPTIONAL_GRADIENT:\n",
    "    gradient_result = minimize(\n",
    "        objective_on_unit_scale, vector_to_unit(search_vector),\n",
    "        method='L-BFGS-B', jac='2-point',\n",
    "        bounds=[(0.0, 1.0)] * len(parameter_names),\n",
    "        options={'maxiter': GRADIENT_MAXITER, 'ftol': 1e-10,\n",
    "                 'gtol': 1e-6, 'maxls': 40},\n",
    "    )\n",
    "    gradient_vector = unit_to_vector(gradient_result.x)\n",
    "    gradient_score, gradient_diagnostics = evaluate_vector(\n",
    "        gradient_vector, blocks, inputs, base, overlap_weighted=True,\n",
    "        objective_metric='poisson_nll',\n",
    "    )\n",
    "    pd.DataFrame(gradient_history).to_csv(\n",
    "        OUTPUT / '10_gradient_optimization_trials.csv', index=False\n",
    "    )\n",
    "    pd.DataFrame([{'pipeline_version': PIPELINE_VERSION, **gradient_vector}]).to_csv(\n",
    "        OUTPUT / '13_gradient_fitted_parameters.csv', index=False\n",
    "    )\n",
    "    print('Optional L-BFGS-B success:', gradient_result.success)\n",
    "    print('Optional L-BFGS-B message:', gradient_result.message)\n",
    "    print(f'Diagnostic Poisson NLL: {search_score:.8f} -> {gradient_score:.8f}')\n",
    "else:\n",
    "    for stale_name in ('10_gradient_optimization_trials.csv',\n",
    "                       '13_gradient_fitted_parameters.csv',\n",
    "                       '14_gradient_optimization_trace.png'):\n",
    "        stale_path = OUTPUT / stale_name\n",
    "        if stale_path.exists():\n",
    "            stale_path.unlink()\n",
    "    print('Optional gradient diagnostic skipped; stale diagnostic outputs removed.')"
   ]
  },
  {
   "cell_type": "markdown",
   "id": "cf1a8783",
   "metadata": {},
   "source": [
    "## 4. Select and save the canonical non-seasonal vector\n",
    "\n",
    "The downstream seasonal fit reads `03_poisson_fitted_parameters.csv`. This canonical file always contains the bounded random-search result. An optional gradient result, when requested, is written to a separate diagnostic file and cannot overwrite it."
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "id": "0d58689d",
   "metadata": {},
   "outputs": [],
   "source": [
    "selected_method = 'bounded random search with local/Powell refinement'\n",
    "selected_vector = search_vector\n",
    "selected_score = search_score\n",
    "selected_diagnostics = search_diagnostics\n",
    "pd.DataFrame([{'pipeline_version': PIPELINE_VERSION,\n",
    "               'selected_method': selected_method, **selected_vector}]).to_csv(\n",
    "    DEFAULT_LONDON_POISSON_FITTED_PARAMETERS, index=False\n",
    ")\n",
    "selected_diagnostics.drop(columns=['observed', 'predicted']).to_csv(\n",
    "    OUTPUT / '02_poisson_window_diagnostics.csv', index=False\n",
    ")\n",
    "selection_rows = [\n",
    "    {'method': selected_method, 'poisson_nll': search_score, 'selected': True},\n",
    "]\n",
    "if RUN_OPTIONAL_GRADIENT:\n",
    "    selection_rows.append({\n",
    "        'method': 'optional numerical-gradient L-BFGS-B diagnostic',\n",
    "        'poisson_nll': gradient_score, 'selected': False,\n",
    "        'optimizer_success': gradient_result.success,\n",
    "    })\n",
    "selection = pd.DataFrame(selection_rows)\n",
    "old_selection_path = OUTPUT / '12_gradient_metric_comparison.csv'\n",
    "if old_selection_path.exists():\n",
    "    old_selection_path.unlink()\n",
    "selection.to_csv(OUTPUT / '12_fit_method_comparison.csv', index=False)\n",
    "display(selection)\n",
    "display(fitted_parameter_table(base, selected_vector, FIT_PARAMETER_BOUNDS))\n",
    "print('Canonical method:', selected_method)\n",
    "print('Canonical Poisson NLL:', selected_score)\n",
    "print('Saved:', DEFAULT_LONDON_POISSON_FITTED_PARAMETERS)"
   ]
  },
