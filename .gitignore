/experiments/measles/London/observed_vs_simulated_weekly_cases.png
/experiments/measles/London/observed_vs_simulated_weekly_cases_log.png
/experiments/measles/London/simulated_weekly_deaths.png
/experiments/measles/London/validation_metrics.csv
/experiments/measles/London/weekly_validation_summary.csv

# Superseded age-only prototype code and alternative contact-matrix builds.
# Keep the transparent builder and the final matrix/source note.
/experiments/measles_age/age_model.py
/experiments/measles_age/build_contact_matrix.py
/experiments/measles_age/build_reconnect_contact_matrix.py
/experiments/measles_age/fit_age_blocks.py
/experiments/measles_age/prepare_age_data.py
/experiments/measles_age/inputs/*
!/experiments/measles_age/inputs/age_contact_matrix_reconnect_figure_normalized.csv
!/experiments/measles_age/inputs/age_contact_matrix_reconnect_figure_source_note.csv
/experiments/measles_age/output/

# Keep only the fitted summary consumed by the final model. The block-level
# fitting traces are regenerated by fit_local_age_blocks.py.
/experiments/measles_local_age/output/*
!/experiments/measles_local_age/output/local_age_parameter_summary.csv

# Keep the documented repository data snapshots; ignore ad-hoc additions.
/data/*
!/data/README.md
!/data/ukhsa-measles_weekly_cases.csv
!/data/england_measles_cases_by_age_and_region_2023_2026.csv
!/data/measles-coverage-2024-to-2025.csv
!/data/west_midlands_measles_cases_by_age.csv

# Graph builders create many diagnostics. These matrices are direct final-model
# inputs; the topology tables support the optional network preprocessing step.
/outbreak_risk_model/graph_outputs/*
