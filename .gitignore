# Superseded measles experiments. The final workflow uses only the named
# London and all-regions result directories retained below.
/experiments/*.py
/experiments/measles/*.pkl
/experiments/measles/England*/
/experiments/measles/West_Midlands/
/experiments/measles/all_block_parameter_fit*/
/experiments/measles/daily_block_parameter_fit*/
/experiments/measles/deaths_too/
/experiments/measles/notebook_England*/
/experiments/measles/parameter_fit*/
/experiments/measles/validation*/
